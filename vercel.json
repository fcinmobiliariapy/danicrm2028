{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": "{server.ts,src/server/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
